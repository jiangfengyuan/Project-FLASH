<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="capture_idea"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_capture"
        android:shortcutShortLabel="@string/shortcut_idea">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="flash://capture?category=idea"
            android:targetPackage="com.flash.app"
            android:targetClass="com.flash.app.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="capture_log"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_capture"
        android:shortcutShortLabel="@string/shortcut_log">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="flash://capture?category=log"
            android:targetPackage="com.flash.app"
            android:targetClass="com.flash.app.MainActivity" />
    </shortcut>
</shortcuts>
