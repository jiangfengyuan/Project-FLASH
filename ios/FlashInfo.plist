<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBonjourServices</key>
	<array><string>_flashbackup2._tcp</string></array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>用于在你主动开启安全局域网传输时发现并连接另一台 Flash 设备；两端核对短码并确认后才传输备份。</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.flash.app.ios.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>flash</string>
			</array>
		</dict>
	</array>
	<key>UIAppFonts</key>
	<array>
		<string>LXGWWenKai-Medium.ttf</string>
	</array>
</dict>
</plist>
