    "，情绪整体更低落一些": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "، وكان المزاج أقل قليلًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ", und die Stimmung war etwas gedrückter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ", and your mood was a bit lower"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ", et l'humeur a un peu baissé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "、気分は少し落ち込み気味でした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ", 기분은 조금 가라앉았어요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ", и настроение было немного хуже"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，情绪整体更低落一些"
          }
        }
      }
    },
