    "-3 至 +3，0 为中性；无记录日期不计入均值": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من ‎−3‎ إلى ‎+3‎، و0 محايد؛ الأيام بلا تسجيل لا تدخل في المتوسط"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "−3 bis +3, 0 ist neutral; Tage ohne Einträge zählen nicht zum Durchschnitt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "−3 to +3, 0 is neutral; days with no entries aren't averaged"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "−3 à +3, 0 est neutre ; les jours sans entrée ne comptent pas dans la moyenne"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "−3〜+3、0 は中立。記録のない日は平均に含みません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "-3~+3, 0은 보통; 기록 없는 날은 평균에서 제외"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "от −3 до +3, 0 — нейтрально; дни без записей не входят в среднее"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "-3 至 +3，0 为中性；无记录日期不计入均值"
          }
        }
      }
    },
