      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم هذا الجهاز منطقة زمنية في النسخة. حدّث النظام وحاول مجددًا. لم يُستورد شيء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät unterstützt eine Aufgaben-Zeitzone im Backup nicht. System aktualisieren und erneut versuchen. Es wurde nichts importiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device doesn't support a task time zone in the backup. Update the system and try again. Nothing was imported"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne prend pas en charge un fuseau horaire de la sauvegarde. Mettez à jour le système et réessayez. Rien n'a été importé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末はバックアップ内のタイムゾーンに対応していません。システムを更新してお試しください。何も読み込まれていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 백업의 할 일 시간대를 지원하지 않습니다. 시스템을 업데이트한 뒤 다시 시도하세요. 아무것도 가져오지 않았습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство не поддерживает часовой пояс задачи из копии. Обновите систему и повторите. Ничего не импортировано"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不支持备份中的任务时区，请更新系统后重试；未导入任何数据"
          }
        }
      }
    },
