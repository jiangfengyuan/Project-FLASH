    "%@：不符合备份契约，请检查文件或使用恢复入口": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: لا يطابق تنسيق النسخة الاحتياطية. تحقق من الملف أو استخدم الاستعادة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: entspricht nicht dem Backup-Format. Datei prüfen oder Wiederherstellung verwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: doesn't match the backup format. Check the file or use the recovery import"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : non conforme au format de sauvegarde. Vérifiez le fichier ou utilisez la restauration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
