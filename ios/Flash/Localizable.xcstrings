            "state": "translated",
            "value": "يتعذر فتح القاعدة المحلية: التصدير والاستيراد والنقل والمسح متوقفة. البيانات دون تغيير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale Datenbank lässt sich nicht öffnen: Export, Import, Übertragung und Löschen sind pausiert. Daten unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local database can't be opened: export, import, transfer and clear are paused. Existing data is unchanged."
          }
