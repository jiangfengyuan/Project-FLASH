    "本地数据在预览后有变化，差异已重新计算，请确认后再覆盖": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيرت البيانات المحلية بعد المعاينة. أُعيد حساب الفروق. أكّد قبل الاستبدال"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
