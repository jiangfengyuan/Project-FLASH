    "%@你记录得比%@更频繁": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّلت %1$@ أكثر من %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hast du öfter erfasst als %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You recorded more often %1$@ than %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez noté plus souvent %1$@ que %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@より多く記録しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) %2$@보다 더 자주 기록했어요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ вы записывали чаще, чем %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@你记录得比%@更频繁"
          }
        }
      }
    },
