    "备份为明文 JSON，可存到「文件」或用隔空投送发给自己的其他设备。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخ بصيغة JSON غير مشفرة. احفظها في «الملفات» أو أرسلها عبر AirDrop إلى أجهزتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups sind unverschlüsseltes JSON. In „Dateien“ sichern oder per AirDrop an deine Geräte senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups are plain JSON. Save to Files or AirDrop them to your other devices."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes sont en JSON non chiffré. Enregistrez-les dans Fichiers ou envoyez-les par AirDrop à vos appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップは暗号化されない JSON です。「ファイル」に保存するか、AirDrop で自分の端末に送れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업은 일반 JSON입니다. '파일'에 저장하거나 AirDrop으로 내 다른 기기에 보내세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии — открытый JSON. Сохраните в «Файлы» или отправьте через AirDrop на свои устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份为明文 JSON，可存到「文件」或用隔空投送发给自己的其他设备。"
          }
        }
      }
    },
    "备份内容未做端到端加密，请仅在可信的家庭或办公局域网使用。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخة ليست مشفرة بين الطرفين. استخدم الشبكات الموثوقة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup ist nicht Ende-zu-Ende-verschlüsselt. Nur vertrauenswürdige Netzwerke verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup isn't end-to-end encrypted. Only use trusted home or office networks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde n'est pas chiffrée de bout en bout. Utilisez uniquement un réseau de confiance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップはエンドツーエンド暗号化されていません。信頼できるネットワークでのみ使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업은 종단 간 암호화되지 않습니다. 신뢰할 수 있는 네트워크에서만 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия без сквозного шифрования. Используйте только доверенные сети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份内容未做端到端加密，请仅在可信的家庭或办公局域网使用。"
          }
        }
      }
    },
    "备份文件不是有效的 JSON 对象": {
