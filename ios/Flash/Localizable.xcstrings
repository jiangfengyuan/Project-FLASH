    "无云端账号，备份与传输由你主动发起。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حساب سحابي. لا تبدأ النسخ والنقل إلا بطلبك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Cloud-Konto. Backups und Übertragungen starten nur auf deine Anweisung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cloud account. Backups and transfers only happen when you start them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte cloud. Sauvegardes et transferts à votre demande uniquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドアカウントはありません。バックアップと転送はあなたが始めたときだけ行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 계정이 없습니다. 백업과 전송은 직접 시작할 때만 이루어집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без облачного аккаунта. Копии и передача — только по вашему запросу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无云端账号，备份与传输由你主动发起。"
          }
        }
      }
    },
    "无法打开所选文件，请重试": {
      "localizations": {
        "ar": {
