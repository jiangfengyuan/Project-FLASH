{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flash.local/contracts/flash-backup-v3.schema.json",
  "title": "Flash complete backup v3",
  "description": "严格互通文档；不是现有客户端容错导入算法。语义校验及兼容边界见 README.md。分区版本声明结构：schemas 为 1 的分区禁止收藏/强度/来源字段，为 2 时允许（均可选）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "exportedAt",
    "appVersion",
    "notes",
    "schemas",
    "data",
    "personalLibrary"
  ],
  "properties": {
    "version": {
      "const": "flash-backup-v3"
    },
    "exportedAt": {
      "$ref": "#/$defs/instant"
    },
    "appVersion": {
      "type": "string"
    },
    "notes": {
      "$ref": "#/$defs/text"
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logs",
        "emotions",
        "tasks"
      ],
      "properties": {
        "logs": {
          "enum": [
            1,
            2
          ]
        },
        "emotions": {
          "enum": [
            1,
            2
          ]
        },
        "tasks": {
          "enum": [
            1,
            2
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logs",
        "emotions",
        "tasks"
      ],
      "properties": {
        "logs": {
          "type": "array",
          "maxItems": 100000
        },
        "emotions": {
          "type": "array",
          "maxItems": 100000
        },
        "tasks": {
          "type": "array",
          "maxItems": 100000
        }
      }
    },
    "personalLibrary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tags",
        "links",
        "filters",
        "reminders",
        "showEmotions",
        "summaryHour",
        "summaryMinute",
        "summaryEnabled",
        "summaryIntervalDays",
        "remindersNeedConfirmation"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          },
          "maxItems": 1000
        },
        "links": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "maxItems": 20
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "kinds",
              "query",
              "tagIDs",
              "matchAll",
              "colors",
              "favoritesOnly",
              "startDay",
              "endDay",
              "taskStatus",
              "oldestFirst"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "kinds": {
                "type": "array",
                "items": {
                  "enum": [
                    "log",
                    "idea",
                    "emotion",
                    "task"
                  ]
                },
                "maxItems": 4
              },
              "query": {
                "type": "string",
                "maxLength": 100000
              },
              "tagIDs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "maxItems": 1000
              },
              "matchAll": {
                "type": "boolean"
              },
              "colors": {
                "type": "array",
                "items": {
                  "enum": [
                    "urgent",
                    "inspiration",
                    "daily",
                    "memo",
                    "emotion",
                    "idea"
                  ]
                },
                "maxItems": 6
              },
              "favoritesOnly": {
                "type": "boolean"
              },
              "startDay": {
                "type": "string",
                "maxLength": 10
              },
              "endDay": {
                "type": "string",
                "maxLength": 10
              },
              "taskStatus": {
                "enum": [
                  "all",
                  "open",
                  "completed"
                ]
              },
              "oldestFirst": {
                "type": "boolean"
              }
            }
          },
          "maxItems": 100
        },
        "reminders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "enabled",
              "intervalDays",
              "hour",
              "minute",
              "anchorDay"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "enabled": {
                "type": "boolean"
              },
              "intervalDays": {
                "enum": [
                  1,
                  3,
                  7
                ]
              },
              "hour": {
                "type": "integer",
                "minimum": 9,
                "maximum": 21
              },
              "minute": {
                "type": "integer",
                "minimum": 0,
                "maximum": 59
              },
              "anchorDay": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "maxItems": 100000
        },
        "showEmotions": {
          "type": "boolean"
        },
        "summaryHour": {
          "type": "integer",
          "minimum": 9,
          "maximum": 21
        },
        "summaryMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "summaryEnabled": {
          "type": "boolean"
        },
        "summaryIntervalDays": {
          "enum": [
            1,
            3,
            7
          ]
        },
        "remindersNeedConfirmation": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "schemas": {
            "type": "object",
            "properties": {
              "logs": {
                "const": 1
              }
            },
            "required": [
              "logs"
            ]
          }
        },
        "required": [
          "schemas"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "logs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/logV1"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "logs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/logV2"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "schemas": {
            "type": "object",
            "properties": {
              "emotions": {
                "const": 1
              }
            },
            "required": [
              "emotions"
            ]
          }
        },
        "required": [
          "schemas"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "emotions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/emotionV1"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "emotions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/emotionV2"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "schemas": {
            "type": "object",
            "properties": {
              "tasks": {
                "const": 1
              }
            },
            "required": [
              "tasks"
            ]
          }
        },
        "required": [
          "schemas"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "tasks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/taskV1"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "tasks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/taskV2"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "$comment": "沿用现有 UUID 外形校验，不追加 version/variant 位限制。分区内 ID 唯一性由语义校验负责。"
    },
    "optionalId": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "optionalBoolean": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "optionalIntensity": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        {
          "type": "null"
        }
      ],
      "$comment": "情绪强度 1–5，可缺省或 null；布尔值不能冒充整数（语义层已有惯例）。"
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date",
      "$comment": "必须启用 format 校验，并限制为公历 0001–9999 年的真实日期。"
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "format": "date-time",
      "$comment": "还须拒绝闰秒、无效日期、未知偏移 -00:00；规范化输出为 UTC 毫秒，见 README。"
    },
    "text": {
      "type": "string",
      "maxLength": 100000,
      "$comment": "语义层额外限制 UTF-16 code units <= 100000。"
    },
    "optionalText": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "optionalInstant": {
      "anyOf": [
        {
          "$ref": "#/$defs/instant"
        },
        {
          "type": "null"
        }
      ]
    },
    "colorTag": {
      "enum": [
        "urgent",
        "inspiration",
        "daily",
        "memo",
        "emotion",
        "idea"
      ]
    },
    "importance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "logV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content",
        "colorTag",
        "category",
        "importance",
        "createdAt",
        "recordDate"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "content": {
          "$ref": "#/$defs/text"
        },
        "colorTag": {
          "$ref": "#/$defs/colorTag"
        },
        "category": {
          "enum": [
            "log",
            "idea"
          ]
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "createdAt": {
          "$ref": "#/$defs/instant"
        },
        "recordDate": {
          "$ref": "#/$defs/day"
        }
      }
    },
    "logV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content",
        "colorTag",
        "category",
        "importance",
        "createdAt",
        "recordDate"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "content": {
          "$ref": "#/$defs/text"
        },
        "colorTag": {
          "$ref": "#/$defs/colorTag"
        },
        "category": {
          "enum": [
            "log",
            "idea"
          ]
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "isFavorite": {
          "$ref": "#/$defs/optionalBoolean"
        },
        "createdAt": {
          "$ref": "#/$defs/instant"
        },
        "recordDate": {
          "$ref": "#/$defs/day"
        }
      }
    },
    "emotionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "level",
        "createdAt",
        "recordDate"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "level": {
          "type": "integer",
          "minimum": -3,
          "maximum": 3
        },
        "subEmotion": {
          "enum": [
            "sad",
            "angry",
            "uncomfortable",
            null
          ]
        },
        "note": {
          "$ref": "#/$defs/optionalText"
        },
        "status": {
          "$ref": "#/$defs/optionalText"
        },
        "createdAt": {
          "$ref": "#/$defs/instant"
        },
        "recordDate": {
          "$ref": "#/$defs/day"
        }
      }
    },
    "emotionV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "level",
        "createdAt",
        "recordDate"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "level": {
          "type": "integer",
          "minimum": -3,
          "maximum": 3
        },
        "subEmotion": {
          "enum": [
            "sad",
            "angry",
            "uncomfortable",
            null
          ]
        },
        "note": {
          "$ref": "#/$defs/optionalText"
        },
        "status": {
          "$ref": "#/$defs/optionalText"
        },
        "intensity": {
          "$ref": "#/$defs/optionalIntensity"
        },
        "isFavorite": {
          "$ref": "#/$defs/optionalBoolean"
        },
        "createdAt": {
          "$ref": "#/$defs/instant"
        },
        "recordDate": {
          "$ref": "#/$defs/day"
        }
      }
    },
    "due": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "date"
          ],
          "properties": {
            "kind": {
              "const": "allDay"
            },
            "date": {
              "$ref": "#/$defs/day"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "at",
            "timeZone"
          ],
          "properties": {
            "kind": {
              "const": "dateTime"
            },
            "at": {
              "$ref": "#/$defs/instant"
            },
            "timeZone": {
              "type": "string",
              "minLength": 1,
              "$comment": "语义层检查三端支持的时区标识；不能仅凭字符串判定。"
            }
          }
        }
      ]
    },
    "taskV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "colorTag",
        "importance",
        "due",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "pattern": "\\S",
          "$comment": "原始 UTF-16 长度 <= 200；ECMAScript trim 后非空。"
        },
        "notes": {
          "$ref": "#/$defs/optionalText"
        },
        "colorTag": {
          "$ref": "#/$defs/colorTag"
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "due": {
          "$ref": "#/$defs/due"
        },
        "reminderAt": {
          "$ref": "#/$defs/optionalInstant"
        },
        "completedAt": {
          "$ref": "#/$defs/optionalInstant"
        },
        "createdAt": {
          "$ref": "#/$defs/instant"
        },
        "updatedAt": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "taskV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "colorTag",
        "importance",
        "due",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "pattern": "\\S",
          "$comment": "原始 UTF-16 长度 <= 200；ECMAScript trim 后非空。"
        },
        "notes": {
          "$ref": "#/$defs/optionalText"
        },
        "colorTag": {
          "$ref": "#/$defs/colorTag"
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "due": {
          "$ref": "#/$defs/due"
        },
        "sourceLogId": {
          "$ref": "#/$defs/optionalId",
          "$comment": "Idea→Task 来源关联：指向 logs 分区的一条记录 ID。"
        },
        "isFavorite": {
          "$ref": "#/$defs/optionalBoolean"
        },
        "reminderAt": {
          "$ref": "#/$defs/optionalInstant"
        },
        "completedAt": {
          "$ref": "#/$defs/optionalInstant"
        },
        "createdAt": {
          "$ref": "#/$defs/instant"
        },
        "updatedAt": {
          "$ref": "#/$defs/instant"
        }
      }
    }
  }
}
